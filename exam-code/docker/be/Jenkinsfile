pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('1')
        DOCKER_REGISTRY = 'amit142'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        REPO_NAME = 'be'
        DOCKERFILE_PATH = "exam-code/docker/be"
    }

    stages {
        stage('Clone Repository') {
            steps {
                script {
                    git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/amit142/devopshift-welcome.git'
                }
            }
        }

        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        script {
                            sh 'pip install flake8'
                            def lintResult = sh(script: 'flake8 .', returnStatus: true)
                            if (lintResult != 0) {
                                echo "Flake8 linting failed with exit code: ${lintResult}"
                            } else {
                                echo "Flake8 linting passed"
                            }
                        }
                    }
                }

                stage('Bandit Security Scan') {
                    steps {
                        script {
                            sh 'pip install bandit'
                            def banditResult = sh(script: 'bandit -r .', returnStatus: true)
                            if (banditResult != 0) {
                                echo "Bandit security scan failed with exit code: ${banditResult}"
                            } else {
                                echo "Bandit security scan passed"
                            }
                        }
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    def requirementsFile = "exam-code/docker/be/requirements.txt"
                    sh "pip install -r ${requirementsFile}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Create a temporary Dockerfile with the correct paths
                    sh '''
                    cat > backend.Dockerfile << 'EOF'
FROM python:3.12-slim
WORKDIR /app
COPY exam-code/docker/be/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY exam-code/docker/be/src/* .
CMD ["python", "mainbe.py"]
EXPOSE 5001
EOF
                    '''
                    
                    // Build using the temporary Dockerfile
                    sh "docker build -t $DOCKER_REGISTRY/be:$IMAGE_TAG -f backend.Dockerfile ."
                    sh "docker tag $DOCKER_REGISTRY/be:$IMAGE_TAG $DOCKER_REGISTRY/be:latest"
                }
            }
        }

        stage('Run Tests in Container') {
            steps {
                script {
                    sh "docker run --rm $DOCKER_REGISTRY/be:$IMAGE_TAG pytest tests/ || echo 'Tests may have failed but continuing'"
                }
            }
        }

        stage('Integration Test with Docker Compose') {
            steps {
                script {
                    sh 'docker-compose -f $DOCKERFILE_PATH/docker-compose.yml up -d'
                    sleep time: 10, unit: 'SECONDS'
                    sh 'curl -f http://localhost:5001 || echo "Integration test failed but continuing"'
                    sh 'docker-compose down'
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    sh "echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin"
                    sh "docker push $DOCKER_REGISTRY/be:$IMAGE_TAG"
                    sh "docker push $DOCKER_REGISTRY/be:latest"
                }
            }
        }
    }
}
