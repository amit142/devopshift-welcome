pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('1')
        DOCKER_REGISTRY = 'amit142'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        REPO_NAME = 'fe'
        DOCKERFILE_PATH = "exam-code/docker/fe"
    }

    stages {
        stage('Clone Repository') {
            steps {
                script {
                    git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/amit142/devopshift-welcome.git'
                }
            }
        }

        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        script {
                            sh 'pip install flake8'
                            def lintResult = sh(script: 'flake8 .', returnStatus: true)
                            if (lintResult != 0) {
                                echo "Flake8 linting failed with exit code: ${lintResult}"
                            } else {
                                echo "Flake8 linting passed"
                            }
                        }
                    }
                }

                stage('Bandit Security Scan') {
                    steps {
                        script {
                            sh 'pip install bandit'
                            def banditResult = sh(script: 'bandit -r .', returnStatus: true)
                            if (banditResult != 0) {
                                echo "Bandit security scan failed with exit code: ${banditResult}"
                            } else {
                                echo "Bandit security scan passed"
                            }
                        }
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    def requirementsFile = "exam-code/docker/fe/requirements.txt"
                    sh "pip install -r ${requirementsFile}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Create a temporary Dockerfile with the correct paths
                    sh '''
                    cat > frontend.Dockerfile << 'EOF'
FROM python:3.12-slim
WORKDIR /app
COPY exam-code/docker/fe/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY exam-code/docker/fe/src/* .
CMD ["python", "mainfe.py"]
EXPOSE 5002
EOF
                    '''
                    
                    // Build using the temporary Dockerfile
                    sh "docker build -t $DOCKER_REGISTRY/fe:$IMAGE_TAG -f frontend.Dockerfile ."
                    sh "docker tag $DOCKER_REGISTRY/fe:$IMAGE_TAG $DOCKER_REGISTRY/fe:latest"
                }
            }
        }

        stage('Integration Test with Docker Compose') {
            
            steps {
                dir('exam-code/docker') {
                sh 'curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose'
                sh 'chmod +x /usr/local/bin/docker-compose'
                sh """
                docker-compose up -d
                sleep 10  # Allow services to start
                docker ps | grep -q 5002 && echo "Port 5002 is mapped and the container is running." || echo "1"  // Adjust port for backend if needed
                docker-compose down
                """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    sh "echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin"
                    sh "docker push $DOCKER_REGISTRY/fe:$IMAGE_TAG"
                    sh "docker push $DOCKER_REGISTRY/fe:latest"
                }
            }
        }
    }
}
